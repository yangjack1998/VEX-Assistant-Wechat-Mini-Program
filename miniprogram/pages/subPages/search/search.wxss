.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start; /* 改为 flex-start */
    min-height: 100vh;
    padding: 20px;
    padding-top: 10vh; /* 设置较大的上边距 */
    box-sizing: border-box;
}

.title {
    font-size: 24px;
    color: #333;
    margin-bottom: 40px;
}

.input {
    height: auto;
    width: calc(100% - 40px);
    max-width: 400px;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
    font-size: 16px;
    box-sizing: border-box;
    margin-bottom: 20px;
}

.submit-button {
    width: calc(100% - 40px);
    max-width: 400px;
    background-color: #1AAD19;
    color: white;
    border-radius: 4px;
    padding: 10px;
    font-size: 16px;
    border: none;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.05);
}

.submit-button:disabled {
    background-color: #9ED99D;
}
